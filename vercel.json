{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/static/built",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://cse-planner-backend.onrender.com/api/:match*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
